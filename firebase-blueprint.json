      "title": "Users",
      "description": "User profiles registered on horsez equine platform",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "fullName": { "type": "string", "description": "Full name of the member" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "equineRole": { "type": "string", "description": "Role in equestrian community" },
