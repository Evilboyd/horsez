rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /favorites/{favoriteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /userHorses/{horseId} {
      allow read, write: if true;
    }

    match /farriers/{farrierId} {
      allow read, write: if true;
    }

    match /marketplaceListings/{listingId} {
      allow read, write: if true;
    }

    match /marketplaceInquiries/{inquiryId} {
      allow read, write: if true;
    }

    match /marketplaceEscrow/{escrowId} {
      allow read, write: if true;
    }

    match /trainers/{trainerId} {
      allow read, write: if true;
    }

    match /veterinarians/{vetId} {
      allow read, write: if true;
    }

    match /transportationListings/{transporterId} {
      allow read, write: if true;
    }

    match /haulJobs/{jobId} {
      allow read, write: if true;
    }

    match /feedSupplies/{productId} {
      allow read, write: if true;
    }

    match /feedOrders/{orderId} {
      allow read, write: if true;
    }

    match /feedBulkQuotes/{quoteId} {
      allow read, write: if true;
    }

    match /lodgingListings/{propertyId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
